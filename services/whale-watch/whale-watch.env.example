# Kadena Whale Watch settings. install.sh copies this to /etc/whale-watch.env (root, mode 600).
# Edit there, then: systemctl restart whale-watch

# Saudi node first (its service API is open to this server only), public node as fallback.
NODE_URLS=http://193.122.85.1:1848,https://api.chainweb-community.org
INDEXER_URL=https://graphql.chaddex.com/graphql

DATA_DIR=/var/lib/whale-watch
PUBLIC_DIR=/var/www/kadena.ws/whales/data
LABELS_FILE=/opt/whale-watch/labels.json

# dry = write posts to /var/lib/whale-watch/posts.jsonl only. live = post to X.
POST_MODE=dry

# Amounts in KDA
MOVE_MIN=100000
POST_MIN=100000
BIG_MIN=500000
HUGE_MIN=1000000

# Alert posts per day (Riyadh day). Platform-share alerts are never capped.
MAX_ALERTS_PER_DAY=6
# Daily summary at this Riyadh hour; on WEEKLY_DAY (5 = Friday) the weekly digest replaces it.
SUMMARY_HOUR=21
WEEKLY_DAY=5

# X API keys of the bot account (OAuth 1.0a, Read and Write). Keep secret.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
